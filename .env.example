# --- Efí (ex-Gerencianet): quando preenchido, os boletos saem pela Efí ---
# Efí → API → Aplicações → criar aplicação com o escopo "API de Emissões" (boletos)
EFI_CLIENT_ID=
EFI_CLIENT_SECRET=
# "homologacao" para testes, "producao" para boletos reais
EFI_AMBIENTE=homologacao

# --- Asaas (usado quando a Efí não está configurada) ---
# Chave da API do Asaas (Minha Conta > Integrações > Chave de API)
ASAAS_API_KEY=

# "sandbox" para testes, "producao" para boletos reais
ASAAS_AMBIENTE=sandbox

# Senha para entrar no painel
PAINEL_SENHA=

# Opcional. Texto aleatório longo, usado para assinar a sessão (ex.: gere com `openssl rand -hex 32`)
SESSION_SECRET=
