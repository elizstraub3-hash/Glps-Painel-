# Chave da API do Asaas (Minha Conta > Integrações > Chave de API)
ASAAS_API_KEY=

# "sandbox" para testes, "producao" para boletos reais
ASAAS_AMBIENTE=sandbox

# Senha para entrar no painel
PAINEL_SENHA=

# Texto aleatório longo, usado para assinar a sessão (ex.: gere com `openssl rand -hex 32`)
SESSION_SECRET=
